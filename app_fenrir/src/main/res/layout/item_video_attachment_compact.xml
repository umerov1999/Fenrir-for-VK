<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    style="?materialCardStyle"
    android:layout_width="@dimen/video_attachment_width"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:foreground="?android:attr/selectableItemBackground"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="@dimen/video_attachment_thumb_width"
            android:layout_height="@dimen/video_attachment_height">

            <dev.ragnarok.fenrir.view.natives.animation.AspectRatioAnimatedShapeableImageView
                android:id="@+id/item_video_album_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MediumRoundedPictures" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_video_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerInParent="true"
                android:background="@drawable/circle_back_white"
                android:backgroundTint="?colorPrimary"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/video"
                app:tint="?white_color_contrast_fix" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/item_video_album_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignEnd="@id/item_video_album_image"
                android:layout_alignBottom="@id/item_video_album_image"
                android:layout_marginBottom="4dp"
                android:background="#90000000"
                android:gravity="center"
                android:padding="4dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="#ffffff"
                android:textStyle="bold"
                tools:text="01:05" />

        </RelativeLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/item_video_album_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textStyle="bold"
            tools:text="Клип @neyerov..." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
